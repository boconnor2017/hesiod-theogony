apiVersion: v1
kind: Namespace
metadata:
  name: kmip
---
# PyKMIP server (KMIP over mutual TLS on 5696). Certificates come from the lab CA (Module 10), in Secret kmip-tls.
# Keys live in a SQLite database on the node's disk: losing it means losing the vSAN key-encryption keys.
apiVersion: v1
kind: ConfigMap
metadata:
  name: kmip-config
  namespace: kmip
data:
  server.conf: |
    [server]
    hostname=0.0.0.0
    port=5696
    certificate_path=/etc/pykmip/tls/server.crt
    key_path=/etc/pykmip/tls/server.key
    ca_path=/etc/pykmip/tls/ca_bundle.crt
    auth_suite=TLS1.2
    policy_path=/data/policies
    enable_tls_client_auth=True
    logging_level=INFO
    database_path=/data/db/pykmip.db
  start.sh: |
    set -e
    export PYTHONPATH=/data/pylib
    # PyKMIP 0.10 needs Python 3.11 (ssl.wrap_socket), SQLAlchemy 1.4 and cryptography 41 (TripleDES/Blowfish still in place)
    if [ ! -f /data/pylib/.hesiod-pykmip-0.10.0 ]; then
      echo "Installing PyKMIP into /data/pylib (first start only)"
      pip install --no-cache-dir --target /data/pylib pykmip==0.10.0 sqlalchemy==1.4.54 cryptography==41.0.7
      touch /data/pylib/.hesiod-pykmip-0.10.0
    fi
    mkdir -p /data/db /data/policies /data/log
    echo "Starting PyKMIP on :5696 (log: /data/log/server.log)"
    exec python -c 'import sys; from kmip.services.server.server import main; sys.argv=["pykmip-server","-f","/etc/pykmip/server.conf","-l","/data/log/server.log"]; sys.exit(main())'
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kmip
  namespace: kmip
  labels:
    app: kmip
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: kmip
  template:
    metadata:
      labels:
        app: kmip
    spec:
      enableServiceLinks: false
      nodeSelector:
        kubernetes.io/hostname: ID:KMS-002
      containers:
      - name: kmip
        image: python:3.11-slim
        imagePullPolicy: IfNotPresent
        command: ["/bin/sh", "/etc/pykmip/start.sh"]
        ports:
        - containerPort: 5696
        readinessProbe:
          tcpSocket:
            port: 5696
          initialDelaySeconds: 10
          periodSeconds: 10
        volumeMounts:
        - name: data
          mountPath: /data
        - name: config
          mountPath: /etc/pykmip/server.conf
          subPath: server.conf
          readOnly: true
        - name: config
          mountPath: /etc/pykmip/start.sh
          subPath: start.sh
          readOnly: true
        - name: tls
          mountPath: /etc/pykmip/tls
          readOnly: true
      volumes:
      - name: data
        hostPath:
          path: ID:KMS-003
          type: DirectoryOrCreate
      - name: config
        configMap:
          name: kmip-config
      - name: tls
        secret:
          secretName: kmip-tls
          defaultMode: 0400
---
apiVersion: v1
kind: Service
metadata:
  name: kmip-service
  namespace: kmip
  annotations:
    metallb.universe.tf/loadBalancerIPs: ID:KMS-001
spec:
  type: LoadBalancer
  selector:
    app: kmip
  ports:
  - name: kmip
    port: 5696
    targetPort: 5696
