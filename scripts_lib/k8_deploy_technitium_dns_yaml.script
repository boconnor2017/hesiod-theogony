apiVersion: v1
kind: Namespace
metadata:
  name: technitium
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: technitium-config-pvc
  namespace: technitium
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 2Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: technitium-dns
  namespace: technitium
  labels:
    app: technitium-dns
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: technitium-dns
  template:
    metadata:
      labels:
        app: technitium-dns
    spec:
      containers:
      - name: dns-server
        image: technitium/dns-server:latest
        imagePullPolicy: IfNotPresent
        ports:
        - name: dns-udp
          containerPort: 53
          protocol: UDP
        - name: dns-tcp
          containerPort: 53
          protocol: TCP
        - name: web-http
          containerPort: 5380
          protocol: TCP
        env: # <--- Corrected field name
        - name: DNS_SERVER_LOG_USING_LOCAL_TIME
          value: "true"
        volumeMounts:
        - name: config-volume
          mountPath: /etc/dns
      volumes:
      - name: config-volume
        emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: technitium-dns-service
  namespace: technitium
  annotations:
    metallb.io/loadBalancerIPs: "ID_DNS-001" 
spec:
  type: LoadBalancer
  selector:
    app: technitium-dns
  ports:
    - name: dns-udp
      port: 53
      targetPort: 53
      protocol: UDP
    - name: dns-tcp
      port: 53
      targetPort: 53
      protocol: TCP
    - name: web-http
      port: 5380
      targetPort: 5380
      protocol: TCP