apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: dns-ip-pool
  namespace: metallb-system
spec:
  # Only hand out IPs that a Service explicitly requests (metallb.universe.tf/loadBalancerIPs);
  # the rest of this range belongs to VCF appliances.
  autoAssign: false
  addresses:
  - ID:DNS-001-ID:DNS-002
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: dns-l2-advert
  namespace: metallb-system
spec:
  ipAddressPools:
  - dns-ip-pool