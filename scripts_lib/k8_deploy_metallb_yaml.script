apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: dns-ip-pool
  namespace: metallb-system
spec:
  addresses:
  - ID:DNS-001-ID:DNS-002
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: dns-l2-advert
  namespace: metallb-system
spec:
  ipAddressPools:
  - dns-ip-pool