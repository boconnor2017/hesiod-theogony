apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: dns-config-pvc
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi  # Technitium config is lightweight, 1Gi is plenty
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dns-server
  labels:
    app: dns-server
spec:
  replicas: 1
  selector:
    matchLabels:
      app: dns-server
  template:
    metadata:
      labels:
        app: dns-server
    spec:
      containers:
        - name: dns-server
          image: technitium/dns-server:latest
          imagePullPolicy: IfNotPresent
          env:
            - name: DNS_SERVER_DOMAIN
              value: "hesiod.local"
          ports:
            - name: web-console
              containerPort: 5380
              protocol: TCP
            - name: dns-udp
              containerPort: 53
              protocol: UDP
            - name: dns-tcp
              containerPort: 53
              protocol: TCP
          volumeMounts:
            - name: config-volume
              mountPath: /etc/dns/config
      volumes:
        - name: config-volume
          persistentVolumeClaim:
            claimName: dns-config-pvc
---
apiVersion: v1
kind: Service
metadata:
  name: dns-server-service
spec:
  selector:
    app: dns-server
  type: NodePort # Changes to LoadBalancer if you have a cloud provider or MetalLB
  ports:
    - name: web-console
      protocol: TCP
      port: 5380
      targetPort: 5380
      nodePort: 32380 # You can access the UI via <Node-IP>:32380
    - name: dns-udp
      protocol: UDP
      port: 53
      targetPort: 53
      nodePort: 30053 # DNS traffic via UDP
    - name: dns-tcp
      protocol: TCP
      port: 53
      targetPort: 53
      nodePort: 30053 # DNS traffic via TCP
